# Certificate manager for amir-zouerami.dev (see docs/cert-auto-renewal.md).
# Caddy issues and renews two Let's Encrypt certificates on its own, about 30 days before they expire:
#   *.amir-zouerami.dev   (wildcard: www, mail, and any other subdomain)
#   amir-zouerami.dev     (the bare domain, which a wildcard does not cover)
# Validation is DNS-01: Caddy adds a temporary _acme-challenge TXT record through the Parspack API.
# Nothing is served from here and no port is published; nginx reads the certificate files from the shared volume.
{
	admin off
	http_port 8080
	https_port 8443
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	acme_dns parspack {$PARSPACK_API_TOKEN}
	skip_install_trust
}

*.{$SERVER_NAME}, {$SERVER_NAME} {
	tls {
		# Parspack rejects a TXT record without an explicit TTL ("The selected ttl is invalid"); 60 s is one of its allowed values
		dns_ttl 60s
		# Parspack's name servers are many machines that pick up a change one by one (measured: new values up to ~90 s, sometimes
		# much longer, and stale answers for deleted records for 10+ minutes). 180 s was not enough in production: wait 8 minutes
		# before asking Let's Encrypt to check. Renewals are rare, so the wait costs nothing.
		propagation_delay 480s
		# -1 = do not query the authoritative name servers ourselves first: the VPS (inside Iran) cannot reach Parspack's
		# name servers on port 53 (timeouts), although Let's Encrypt can. The fixed delay above replaces that check.
		propagation_timeout -1
	}
	respond "certificate manager" 404
}
