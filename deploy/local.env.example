# Settings for deploy/deploy-local.sh. Copy to deploy/local.env (git ignores that file) and fill in.
DEPLOY_HOST=your.server.ip.or.name
DEPLOY_USER=deploy
DEPLOY_PATH=/srv/zouerami
# the private key of the deploy user (leave out to use your ssh agent / default keys)
SSH_KEY=~/.ssh/your_deploy_key
# the local port of the tunnel to the server's registry (change only if 15000 is taken)
TUNNEL_PORT=15000
# Only if your docker builds need a proxy (the same two values as BUILD_NETWORK / BUILD_PROXY in .env). Leave empty otherwise.
BUILD_NETWORK=
BUILD_PROXY=
