---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { dirOf, type Locale, switchPath, t } from '../i18n';
import { getConfig } from '../lib/config';
import { type JsonLd, personLd, websiteLd } from '../lib/jsonld';
import { cursorCss } from '../scripts/cursor';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  nav?: 'home' | 'blog' | 'work' | 'about' | '';
  spotlight?: boolean;
  /** Existing translations of this page (locale → path). Defaults to the same path in both locales. */
  alternates?: Partial<Record<Locale, string>>;
  type?: 'website' | 'article';
  noindex?: boolean;
  image?: string;
  published?: string;
  tags?: string[];
  jsonLd?: JsonLd[];
  /** Override the language of the page content (e.g. an English post inside the Persian chrome). */
  path?: string;
  /** Canonical URL path when it differs from the current one (e.g. a post shown in its other language). */
  canonical?: string;
}
const { title, locale = 'en', nav = '', spotlight = false, description = t(locale).home.description,
  canonical,
  ...seo
} = Astro.props;
const tr = t(locale);
const here = seo.path ?? Astro.url.pathname;
const other: Locale = locale === 'en' ? 'fa' : 'en';
const alternates = seo.alternates ?? { en: switchPath(here, 'en'), fa: switchPath(here, 'fa') };
// The language switch always stays on the same page (and query). `alternates` only drives hreflang for search engines.
const switchHref = switchPath(here, other) + Astro.url.search;
const site = getConfig().siteUrl;
const isHome = here === '/' || here === '/fa';
const jsonLd = [...(seo.jsonLd ?? []), ...(isHome ? [personLd(site), websiteLd(site, locale)] : [])];
---
<!doctype html>
<html lang={locale} dir={dirOf(locale)} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f1f0ea" media="(prefers-color-scheme: light)" />
    <link rel="alternate" type="application/rss+xml" title="RSS (English)" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="RSS (فارسی)" href="/fa/rss.xml" />
    <Seo {title} {description} {locale} {alternates} {...seo} path={canonical ?? here} {jsonLd} />
    <script is:inline>
      (function () {
        function theme() {
          try { return localStorage.getItem('sig-theme') === 'light' ? 'light' : 'dark'; } catch (e) { return 'dark'; }
        }
        document.documentElement.dataset.theme = theme();
        // keep the theme across client-router swaps (no flash)
        document.addEventListener('astro:before-swap', function (e) {
          e.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
        });
      })();
    </script>
    <style is:inline set:html={cursorCss()} data-sig-cursor></style>
    <ClientRouter />
  </head>
  <body id="top" data-nav={nav} data-locale={locale}>
    <a class="skip" href="#main">{tr.skip}</a>
    <Header nav={nav} {locale} {switchHref} />
    {spotlight && <div class="spot" id="spot"></div>}
    <slot />
    <Footer {locale} />
    <div id="wipe" transition:persist hidden aria-hidden="true"><div></div></div>
    <script type="application/json" id="diagram-labels" set:html={JSON.stringify(tr.diagram)} />
    <script type="application/json" id="menu-labels" set:html={JSON.stringify(tr.menu)} />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <div class="langhint" id="langhint" hidden data-locale={locale}>
      <span>{t('fa').langHint.text} / {t('en').langHint.text}</span>
      <a href={switchHref} hreflang={other} data-lang-go>{tr.langHint.go}</a>
      <button type="button" data-lang-dismiss aria-label={tr.langHint.dismiss}>×</button>
    </div>
    <CommandPalette client:idle locale={locale} labels={tr.palette} />
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
