---
import { dirOf, formatDate, type Locale, localePath } from '../i18n';
import { cover, seedOf } from '../lib/cover';
import type { PostSummary } from '../lib/schemas';
import type { TileVariant } from '../lib/tiles';

interface Props {
  post: PostSummary;
  locale: Locale;
  variant: TileVariant;
}
const { post, locale, variant } = Astro.props;
---
<a class={`ptile ptile-${variant}`} href={localePath(locale, `/blog/${post.slug}`)}>
  <div class="ptile-bg" aria-hidden="true">
    {post.cover
      ? <img src={`${post.cover}?thumb=960x0`} srcset={`${post.cover}?thumb=480x0 480w, ${post.cover}?thumb=960x0 960w, ${post.cover}?thumb=1600x0 1600w`} sizes="(max-width: 900px) 100vw, 60vw" alt="" loading="lazy" decoding="async" />
      : <div class="ptile-art" set:html={cover(seedOf(post.slug))}></div>}
  </div>
  <div class="ptile-top">
    <span class="card-tags">{post.tags.slice(0, 2).map((t) => <span class="tagp">{t}</span>)}</span>
    <span class="ptile-meta mono muted"><bdi dir={locale === 'fa' ? 'rtl' : 'ltr'}>{formatDate(post.date, locale)}</bdi><span class="card-langs" dir="ltr">{(['en', 'fa'] as const).map((l) => <span class={`lg ${post.langs.includes(l) ? '' : 'off'}`} title={post.langs.includes(l) ? undefined : (locale === 'fa' ? 'هنوز به این زبان نوشته نشده' : 'Not written in this language yet')}>{l.toUpperCase()}</span>)}</span></span>
  </div>
  <div class="ptile-bottom">
    <h3 dir={dirOf(post.titleLang)} lang={post.titleLang}>{post.title}</h3>
    {post.summary && <p dir={dirOf(post.titleLang)} lang={post.titleLang}>{post.summary}</p>}
  </div>
</a>
