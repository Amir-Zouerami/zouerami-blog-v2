---
import { dirOf, formatDate, type Locale, localePath } from '../i18n';
import { cover, seedOf } from '../lib/cover';
import type { PostSummary } from '../lib/schemas';

interface Props {
  post: PostSummary;
  locale: Locale;
  /** Visual weight in the home grid: 0 = hero card, 1 = second, others = small. */
  rank?: number;
  /** Extra classes, e.g. a grid span override. */
  extra?: string;
}
const { post, locale, rank = 9, extra = '' } = Astro.props;
const size = rank === 0 ? 'xl' : rank === 1 ? 'lg' : 'sm';
---
<a class={`card card-${size} ${extra}`} href={localePath(locale, `/blog/${post.slug}`)}>
  <div class="card-img">
    {post.cover
      ? <img src={post.cover} alt="" loading="lazy" decoding="async" />
      : <div class="card-art" aria-hidden="true" set:html={cover(seedOf(post.slug))}></div>}
    <span class="card-tags">{post.tags.slice(0, 2).map((t) => <span class="tagp">{t}</span>)}</span>
  </div>
  <div class="card-body">
    <span class="mono muted card-meta">{formatDate(post.date, locale)}<span class="card-langs" dir="ltr">{(['en', 'fa'] as const).map((l) => <span class={`lg ${post.langs.includes(l) ? '' : 'off'}`} title={post.langs.includes(l) ? undefined : (locale === 'fa' ? 'هنوز به این زبان نوشته نشده' : 'Not written in this language yet')}>{l.toUpperCase()}</span>)}</span></span>
    <h3 dir={dirOf(post.titleLang)} lang={post.titleLang}>{post.title}</h3>
    {post.summary && <p class="card-sum" dir={dirOf(post.titleLang)} lang={post.titleLang}>{post.summary}</p>}
  </div>
</a>
