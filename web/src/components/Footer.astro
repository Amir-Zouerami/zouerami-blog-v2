---
import { type Locale, t } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const tr = t(locale);
const year = new Date().getFullYear();
---
<footer class="foot pad">
  <p class="foot-pitch mono muted">{tr.footer.pitch}</p>
  <a class="foot-big" href="mailto:hello@zouerami.dev">{tr.footer.hello} <span class="it">{tr.footer.helloEm}</span> ↗</a>
  <div class="foot-row mono">
    <span>{tr.footer.rights} · {year}</span>
    <span class="live"><span data-clock data-label={tr.footer.local}></span></span>
    <span dir="ltr"><a href="http://github.com/amir-zouerami/" rel="me noopener">GitHub</a> / <a href="https://www.linkedin.com/in/amir-zouerami/" rel="me noopener">LinkedIn</a> / <a href={locale === 'fa' ? '/fa/rss.xml' : '/rss.xml'}>RSS</a></span>
    <a href="#top">{tr.footer.top}</a>
  </div>
</footer>
