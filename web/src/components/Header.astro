---
import { localePath, type Locale, LANG_NAMES, t } from '../i18n';
import { MOON, SUN } from './Icons';
interface Props { nav?: string; locale: Locale; switchHref: string }
const { nav = '', locale, switchHref } = Astro.props;
const tr = t(locale);
const other: Locale = locale === 'en' ? 'fa' : 'en';
const NAV = [['home', '/', '01', tr.nav.home], ['blog', '/blog', '02', tr.nav.blog], ['work', '/work', '03', tr.nav.work], ['about', '/about', '04', tr.nav.about]] as const;
---
<header class="head pad">
  <a class="brand" href={localePath(locale, '/')}>zouerami<sup>®</sup></a>
  <nav class="nav" aria-label="Primary">
    {NAV.map(([k, href, n, label]) => (
      <a href={localePath(locale, href)} class={k === nav ? 'on' : ''} aria-current={k === nav ? 'page' : undefined}><em>{n}</em>{label}</a>
    ))}
  </nav>
  <div class="tools">
    <button class="kbd" data-palette-open type="button" aria-label={tr.search}><span>{tr.search}</span> ⌘K</button>
    <a class="sq lang me-link" href={localePath(locale, '/login')} data-me data-label-in={tr.auth.signIn} data-account-href={localePath(locale, '/account')} data-login-href={localePath(locale, '/login')}>{tr.auth.signIn}</a>
    <a class="sq lang" href={switchHref} hreflang={other} lang={other} data-lang-switch={other} aria-label={tr.switchLangLabel} data-astro-reload={undefined}>{LANG_NAMES[other].short}</a>
    <button class="sq" data-theme-toggle type="button" aria-label={tr.toggleTheme}><Fragment set:html={SUN + MOON} /></button>
  </div>
</header>
