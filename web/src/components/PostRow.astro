---
import { dirOf, faDigits, formatDate, type Locale, localePath } from '../i18n';
import type { PostSummary } from '../lib/schemas';
import { UP } from './Icons';
interface Props { post: PostSummary; n: number; locale: Locale }
const { post, n, locale } = Astro.props;
const num = String(n).padStart(2, '0');
---
<a class="row" href={localePath(locale, `/blog/${post.slug}`)}>
  <span class="no">{locale === 'fa' ? faDigits(num) : num}</span>
  <h3 dir={dirOf(post.titleLang)} lang={post.titleLang}>{post.title}</h3>
  <span class="tags">
    {(['en', 'fa'] as const).map((l) => (
      <span class={`lg ${post.langs.includes(l) ? '' : 'off'}`} title={post.langs.includes(l) ? undefined : (locale === 'fa' ? 'هنوز به این زبان نوشته نشده' : 'Not written in this language yet')}>{l.toUpperCase()}</span>
    ))}
    {post.tags.map((t) => <span class="tagp">{t}</span>)}
  </span>
  <span class="when mono muted"><bdi dir={locale === 'fa' ? 'rtl' : 'ltr'}>{formatDate(post.date, locale)}</bdi></span>
  <span class="arr" set:html={UP}></span>
</a>
