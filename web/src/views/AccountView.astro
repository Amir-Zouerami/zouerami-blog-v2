---
import Button from '../ui/Button.astro';
import { type Locale, localePath, t } from '../i18n';
import Base from '../layouts/Base.astro';
const { locale } = Astro.props as { locale: Locale };
const a = t(locale).auth;
const login = localePath(locale, '/login');
---
<Base title={`${a.accountTitle} — zouerami`} {locale} noindex alternates={{}}>
  <main id="main" class="pad auth" data-account data-login={`${login}?next=${encodeURIComponent(localePath(locale, '/account'))}`} data-home={localePath(locale, '/')} data-blog={localePath(locale, '/blog')} data-empty={a.noBookmarks} data-deleted={a.deleted} data-badpw={a.badCredentials} data-generic={a.generic}>
    <div style="padding-block:70px 20px"><span class="mono muted">{a.account}</span><h1 class="h-big" style="margin-top:14px" data-account-name>{a.accountTitle}</h1><p class="mono muted" data-account-email></p></div>
    <div class="sec-label"><span class="mono">[01]</span><span class="mono">{a.bookmarks}</span><span></span></div>
    <div class="rows" data-bookmarks><p class="ui-loading" role="status"><span class="ui-spin" aria-hidden="true"></span></p></div>
    <div class="sec-label" style="margin-top:80px"><span class="mono">[02]</span><span class="mono">{a.danger}</span><span></span></div>
    <p class="muted" style="max-width:56ch;margin-bottom:20px">{a.deleteHelp}</p>
    <form class="auth-form" data-astro-reload data-delete-form>
      <label data-pw-row><span class="mono muted">{a.deletePassword}</span><input type="password" name="password" autocomplete="current-password" dir="ltr" /></label>
      <Button size="lg" type="submit">{a.deleteBtn}</Button>
      <p class="auth-result" data-msg role="status"></p>
    </form>
    <p style="margin-top:40px;display:flex;gap:20px"><Button size="lg" data-signout data-home={localePath(locale, '/')}>{a.signOut}</Button><a class="mono muted" href={localePath(locale, '/privacy')}>{a.privacyLink}</a></p>
  </main>
  <script>
    import { busy, lockFields } from '../lib/busy';
    import { api } from '../lib/client-api';
    import { pageWindow, paginate } from '../lib/paginate';
    import '../scripts/auth-forms';
    function esc(s: string) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
    }
    async function init() {
      const root = document.querySelector<HTMLElement>('[data-account]');
      if (!root) return;
      const me = await api<{ user: { name: string; email: string } }>('/api/auth/me');
      if (!me.ok || !me.data) {
        location.assign(root.dataset.login ?? '/login');
        return;
      }
      root.querySelector('[data-account-name]')!.textContent = me.data.user.name;
      root.querySelector('[data-account-email]')!.textContent = me.data.user.email;
      const list = root.querySelector<HTMLElement>('[data-bookmarks]')!;
      const res = await api<{ bookmarks: { slug: string; title: string; lang: string; date: string }[] }>(`/api/bookmarks?lang=${document.documentElement.lang}`);
      const items = (res.data?.bookmarks ?? []) as { slug: string; title: string; lang: string; date: string }[];
      const fa = document.documentElement.lang === 'fa';
      const digits = (n: number) => (fa ? n.toLocaleString('fa-IR', { useGrouping: false }) : String(n));
      const PER = 10;
      let page = 1;
      const draw = () => {
        const pg = paginate(items, page, PER);
        page = pg.page;
        list.innerHTML = items.length
          ? pg.items.map((b, i) => `<a class="row" href="${fa ? '/fa' : ''}/blog/${esc(b.slug)}"><span class="no">${digits((page - 1) * PER + i + 1).padStart(2, fa ? '' : '0')}</span><h3 dir="${b.lang === 'fa' ? 'rtl' : 'ltr'}" lang="${esc(b.lang)}">${esc(b.title)}</h3><span></span><span class="when mono muted">${esc(b.date)}</span><span></span></a>`).join('')
          : `<p class="mono muted" style="padding:30px 0">${esc(root.dataset.empty ?? '')}</p>`;
        pager.innerHTML = pg.pages > 1
          ? `<button type="button" class="pg" data-p="${page - 1}" ${page <= 1 ? 'disabled' : ''}>← ${fa ? 'قبلی' : 'Previous'}</button><span class="pg-nums">${pageWindow(page, pg.pages).map((n) => (n === '…' ? '<span class="pg gap">…</span>' : `<button type="button" class="pg ${n === page ? 'cur' : ''}" data-p="${n}" ${n === page ? 'aria-current="page"' : ''}>${digits(n)}</button>`)).join('')}</span><button type="button" class="pg" data-p="${page + 1}" ${page >= pg.pages ? 'disabled' : ''}>${fa ? 'بعدی' : 'Next'} →</button>`
          : '';
      };
      const pager = document.createElement('nav');
      pager.className = 'pager';
      pager.setAttribute('aria-label', fa ? 'صفحه‌ها' : 'Pages');
      list.after(pager);
      pager.onclick = (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-p]');
        if (!b || b.disabled) return;
        page = Number(b.dataset.p);
        draw();
      };
      draw();

      const form = root.querySelector<HTMLFormElement>('[data-delete-form]')!;
      form.onsubmit = async (e) => {
        e.preventDefault();
        const msg = form.querySelector<HTMLElement>('[data-msg]')!;
        const password = (form.elements.namedItem('password') as HTMLInputElement).value;
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
        if (button?.dataset.busy !== undefined) return;
        const done = busy(button);
        const unlock = lockFields(form);
        msg.textContent = '';
        const r = await api('/api/account', { method: 'DELETE', json: password ? { password } : {} });
        if (!r.ok) {
          await done();
          unlock();
        }
        if (r.ok) {
          msg.textContent = root.dataset.deleted ?? '';
          msg.dataset.kind = 'ok';
          setTimeout(() => location.assign(root.dataset.home ?? '/'), 1200);
        } else {
          msg.textContent = r.status === 403 ? (root.dataset.badpw ?? '') : (root.dataset.generic ?? '');
          msg.dataset.kind = 'err';
        }
      };
    }
    document.addEventListener('astro:page-load', () => void init());
  </script>
</Base>
