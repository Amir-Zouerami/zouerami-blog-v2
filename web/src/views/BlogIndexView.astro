---
import PostCard from '../components/PostCard.astro';
import { faDigits, formatNumber, type Locale, localePath, t } from '../i18n';
import Base from '../layouts/Base.astro';
import { allTags, filterPosts, groupByYear, loadBlogIndex } from '../lib/pages';
import Unavailable from './Unavailable.astro';

const { locale } = Astro.props as { locale: Locale };
const tr = t(locale);
const page = await loadBlogIndex(locale);
const all = page.kind === 'ok' ? page.data : [];
const tag = Astro.url.searchParams.get('tag') ?? 'all';
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 80);
const list = filterPosts(all, { tag, q });
const groups = groupByYear(list, locale);
const tags = allTags(all);
const href = (t: string) => {
  const u = new URLSearchParams();
  if (t !== 'all') u.set('tag', t);
  if (q) u.set('q', q);
  const s = u.toString();
  return localePath(locale, '/blog') + (s ? `?${s}` : '');
};
const count = (t: string) => (t === 'all' ? all.length : all.filter((p) => p.tags.includes(t)).length);
const num = (n: number) => formatNumber(n, locale);
---
{page.kind === 'unavailable' ? <Unavailable {locale} /> : (
<Base title={`${tr.blog.title} — zouerami`} description={tr.blog.description} {locale} nav="blog">
  <main id="main" class="pad">
    <div style="padding-block:70px 20px"><span class="mono muted">{tr.blog.crumb}</span><h1 class="h-big" style="margin-top:14px">{tr.blog.title}<sup class="mono" style="color:var(--acc);font-size:16px;vertical-align:top">{num(list.length)}</sup></h1></div>
    <form class="search-in" method="get" action={localePath(locale, '/blog')} role="search">
      <input name="q" value={q} placeholder={tr.blog.searchPlaceholder} autocomplete="off" aria-label={tr.search} />
      {tag !== 'all' && <input type="hidden" name="tag" value={tag} />}
      <kbd>/</kbd>
    </form>
    <div class="filters">
      {['all', ...tags].map((tg) => (
        <a class={`ftab ${tg === tag ? 'on' : ''}`} href={href(tg)} aria-current={tg === tag ? 'true' : undefined}>{tg === 'all' ? tr.blog.all : tg}<sup>{num(count(tg))}</sup></a>
      ))}
    </div>
    <p class="mono muted" style="margin-bottom:14px">{tr.blog.legend}</p>
    {list.length === 0 && <p class="mono muted" style="padding:50px 0">{tr.blog.empty}</p>}
    {groups.map((g) => (
      <>
        <div class="year" dir={locale === 'fa' ? 'rtl' : 'ltr'} lang={locale}>{g.year}</div>
        <div class="cards cards-all">
          {g.posts.map((p) => <PostCard post={p} {locale} />)}
        </div>
      </>
    ))}
  </main>
</Base>
)}
