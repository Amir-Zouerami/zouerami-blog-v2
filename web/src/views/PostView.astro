---
import Comments from '../components/Comments';
import PostActions from '../components/PostActions';
import { dirOf, formatDate, formatNumber, LANG_NAMES, LOCALES, type Locale, localePath, t } from '../i18n';
import Base from '../layouts/Base.astro';
import { getConfig } from '../lib/config';
import { cover, seedOf } from '../lib/cover';
import { blogPostingLd, breadcrumbLd, personLd } from '../lib/jsonld';
import { loadPostPage } from '../lib/pages';
import NotFoundView from './NotFoundView.astro';
import Unavailable from './Unavailable.astro';

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const tr = t(locale);
// The in-post toggle only switches the language of the text (?lang=), never the site language.
const asked = Astro.url.searchParams.get('lang');
const contentLang: Locale = asked === 'en' || asked === 'fa' ? asked : locale;
const page = await loadPostPage(slug, locale, Astro.url.searchParams.get('token') ?? undefined, contentLang);
const data = page.kind === 'ok' ? page.data : null;
const post = data?.post ?? null;
if (post?.preview) Astro.response.headers.set('cache-control', 'no-store');

const fmt = (n: number) => formatNumber(n, locale);
const nameOf = (l: Locale) => LANG_NAMES[l];
const path = localePath(locale, `/blog/${slug}`);
/** Where a language button leads: same page, same chrome; only `?lang` changes (the preview token is kept). */
const langHref = (l: Locale) => {
  const q = new URLSearchParams();
  if (l !== locale) q.set('lang', l);
  const token = Astro.url.searchParams.get('token');
  if (token) q.set('token', token);
  const qs = q.toString();
  return `${path}${qs ? `?${qs}` : ''}`;
};
const canonicalPath = post ? localePath(post.lang, `/blog/${slug}`) : path;
const site = getConfig().siteUrl;
const jsonLd =
  post && !post.preview
    ? [
        personLd(site),
        blogPostingLd({ site, slug: post.slug, title: post.title, description: post.summary || post.title, lang: post.lang, date: post.date, tags: post.tags, image: `/og/${post.lang}/${post.slug}.png`, path: canonicalPath }),
        breadcrumbLd(site, [
          { name: tr.nav.home, path: localePath(locale, '/') },
          { name: tr.nav.blog, path: localePath(locale, '/blog') },
          { name: post.title, path: canonicalPath },
        ]),
      ]
    : [];
---
{page.kind === 'unavailable' ? <Unavailable {locale} /> : !data || !post ? <NotFoundView {locale} path={Astro.url.pathname} /> : (
<Base
  title={`${post.title} — zouerami`}
  description={post.summary || post.title}
  {locale}
  nav="blog"
  spotlight
  type="article"
  published={post.date}
  tags={post.tags}
  noindex={post.preview}
  {jsonLd}
  alternates={post.preview ? {} : data.alternates}
  {path}
  canonical={canonicalPath}
  image={post.preview ? undefined : `/og/${post.lang}/${post.slug}.png`}
>
  <div class="rp"><i id="rp-bar"></i></div>
  <div class="rpill" id="rpill" data-min={data.minutes} data-done={tr.post.done} data-left={tr.post.minLeft} aria-hidden="true">
    <span class="rpill-pct mono" dir="ltr"><b id="rpill-num">0</b><small>%</small></span>
    <span class="rpill-track"><i id="rpill-fill"></i></span>
    <span class="rpill-left mono" id="rpill-left"></span>
    <button type="button" class="rpill-top" data-to-top aria-label={tr.post.backToTop} tabindex="-1"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"/></svg></button>
  </div>
  <main id="main" data-post-slug={post.slug} data-track={post.preview ? undefined : 'view'}>
    <header class="post-head pad">
      <div style="margin-bottom:26px">{post.tags.map((tg) => <span class="tagp">{tg}</span>)} </div>
      <h1 dir={dirOf(post.lang)} lang={post.lang}>{post.title}</h1>
      <div class="meta-grid meta-3">
        <div><span class="mono muted">{tr.post.published}</span><p><bdi dir={locale === 'fa' ? 'rtl' : 'ltr'}>{formatDate(post.date, locale, true)}</bdi></p></div>
        <div><span class="mono muted">{tr.post.reading}</span><p>{fmt(data.minutes)} {tr.post.min}</p></div>
        <div><span class="mono muted">{tr.post.views}</span><p id="views">{fmt(post.views)}</p></div>
      </div>
    </header>
    <div class="post-cover" aria-hidden="true">{post.cover ? <img src={`${post.cover}?thumb=1600x0`} srcset={`${post.cover}?thumb=960x0 960w, ${post.cover}?thumb=1600x0 1600w`} sizes="100vw" alt="" fetchpriority="high" decoding="async" style="width:100%;height:100%;object-fit:cover" /> : <Fragment set:html={cover(seedOf(post.slug))} />}</div>
    <div class="art pad">
      <aside class="side">
        <div class="mono muted" style="margin-bottom:10px">{tr.post.onThisPage}</div>
        <div id="toc">{data.headings.map((hd) => <a href={`#${hd.id}`} dir={dirOf(post.lang)}>{hd.text}</a>)}</div>
        {post.preview ? <div class="acts"><button type="button" data-share>{tr.post.share}</button></div> : <PostActions client:visible postId={post.id} loginHref={localePath(locale, '/login')} labels={{ like: tr.post.like, save: tr.post.save, share: tr.post.share, copied: tr.post.copied }} {locale} />}
      </aside>
      <article>
        <div class="langbar">
          <div class="langseg" role="group" aria-label={tr.post.language}>
            {LOCALES.map((l) => post.langs.includes(l)
              ? <a class={l === post.lang ? 'cur' : ''} href={langHref(l)} hreflang={l} lang={l} data-content-lang={l} aria-current={l === post.lang ? 'true' : undefined}>{nameOf(l).native}</a>
              : <span class="off" lang={l} title={tr.post.notWritten} aria-disabled="true"><span class="nm">{nameOf(l).native}</span><small>{tr.post.notWritten}</small></span>)}
          </div>
        </div>
        {post.preview && <p class="notice" role="note">{tr.post.preview}</p>}
        {post.fellBack && <p class="notice" role="note">{tr.post.onlyIn(tr.post.langNames[post.lang])}</p>}
        <div class="prose" lang={post.lang} dir={dirOf(post.lang)} set:html={data.html}></div>
        {!post.preview && <Comments client:visible postId={post.id} loginHref={localePath(locale, '/login')} labels={{ ...tr.comments }} {locale} />}
      </article>
      <div></div>
    </div>
    <nav class="nextprev" aria-label="Posts">
      {data.previous ? <a href={localePath(locale, `/blog/${data.previous.slug}`)} rel="prev"><span class="mono muted">{tr.post.previous}</span><h3 dir={dirOf(data.previous.titleLang)} lang={data.previous.titleLang}>{data.previous.title}</h3></a> : <span></span>}
      {data.next ? <a href={localePath(locale, `/blog/${data.next.slug}`)} rel="next"><span class="mono muted">{tr.post.next}</span><h3 dir={dirOf(data.next.titleLang)} lang={data.next.titleLang}>{data.next.title}</h3></a> : <span></span>}
    </nav>
  </main>
  <script>
    import '../scripts/post';
  </script>
</Base>
)}
