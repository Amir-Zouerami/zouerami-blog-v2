---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
let path = Astro.url.pathname;
try {
  path = decodeURIComponent(path);
} catch {
  /* keep the raw path */
}
---
<Base title="404 — zouerami">
  <main class="pad nf">
    <h1><span>4</span><span>0</span><span>4</span></h1>
    <div class="tty">
      <div><span class="p">$</span> cd <span id="path">{path}</span></div>
      <div class="muted">zsh: no such file or directory</div>
      <div><span class="p">$</span> try: <a href="/" style="color:var(--acc);border-bottom:1px solid">cd ~</a> <span class="caret"></span></div>
    </div>
    <div><a class="btn solid" href="/">Home</a></div>
  </main>
</Base>
