# copy to .env
PB_URL=http://pocketbase:8090
PB_PUBLIC_URL=/pb
SITE_URL=http://localhost:8088
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-please-123

# Optional: only if image builds cannot reach the internet directly (host-side proxy)
BUILD_NETWORK=default
BUILD_PROXY=

# Host port for nginx
HTTP_PORT=8088

# Signing key for session JWTs (>=32 chars). Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-openssl-rand-base64-48-output

# Mail (dev: Mailpit catches everything at http://127.0.0.1:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
MAIL_FROM=no-reply@zouerami.dev

# Cloudflare Turnstile (leave empty to disable in dev)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Production only
SERVER_NAME=zouerami.dev
CACHE_TTL=60
# Nightly PocketBase backups are copied to S3-compatible storage when these are set
S3_BACKUP_BUCKET=
S3_BACKUP_REGION=auto
S3_BACKUP_ENDPOINT=
S3_BACKUP_KEY=
S3_BACKUP_SECRET=
S3_BACKUP_PATH_STYLE=false
# OAuth (optional): configure the providers in the PocketBase admin; callback is ${SITE_URL}/api/auth/oauth/callback
